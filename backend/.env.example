# CareNest Backend Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://carenest_user:carenest_secure_password_2026@localhost:5432/carenest_db?schema=public

# Database Mode: set to "auto" (attempts Prisma/Postgres, falls back to in-memory store if offline), "postgres", or "mock"
DB_MODE=auto

# Security & Authentication
JWT_SECRET=carenest_super_secret_jwt_key_development_only_2026_change_in_production
JWT_EXPIRES_IN=7d

# Redis Configuration (BullMQ Background Jobs)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email / Notifications (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_password
EMAIL_FROM="CareNest Health" <no-reply@carenest.health>

