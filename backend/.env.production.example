# ==============================================================================
# CareNest Backend - Production Environment Variables Template
# Copy to .env in your hosting provider (Render, Railway, AWS, Heroku)
# NEVER commit raw production secrets to source control.
# ==============================================================================

# 1. Server Configuration
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=https://carenest.vercel.app,https://carenest-frontend.vercel.app

# 2. Managed PostgreSQL Database (Neon, Supabase, Render, AWS RDS)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL="postgresql://carenest_admin:YourDbPassword@ep-cool-db.us-east-2.aws.neon.tech/carenest_db?sslmode=require"

# 3. Redis-Compatible Managed Cache & Queues (Upstash, Redis Cloud)
# Format: rediss://default:<PASSWORD>@<HOST>:<PORT> (use rediss:// for TLS)
REDIS_URL="rediss://default:YourRedisPassword@carenest-redis.upstash.io:6379"

# 4. Cryptographic Secrets & JWT Sessions
# Generate with: openssl rand -base64 48
JWT_SECRET="YOUR_HIGH_ENTROPY_JWT_SECRET_KEY_MINIMUM_64_CHARACTERS_REQUIRED"
JWT_REFRESH_SECRET="YOUR_HIGH_ENTROPY_JWT_REFRESH_SECRET_KEY_MINIMUM_64_CHARACTERS"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# 5. Cookie Security Settings
COOKIE_DOMAIN=".onrender.com"
COOKIE_SECURE="true"
COOKIE_SAME_SITE="none"

# 6. Medical Records Vault HMAC Encryption
# Used to generate cryptographically signed 15-minute download links
VAULT_HMAC_SECRET="YOUR_HIGH_ENTROPY_HMAC_SHA256_VAULT_SIGNING_SECRET"

# 7. Private Object Storage (AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER="s3"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA_YOUR_PRODUCTION_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_PRODUCTION_SECRET_KEY"
AWS_S3_BUCKET="carenest-private-medical-vault"
AWS_S3_ENDPOINT=""

# 8. Transactional Email Provider (SendGrid, Resend, Postmark, AWS SES)
EMAIL_PROVIDER="smtp"
EMAIL_FROM="CareNest Health <noreply@carenest.health>"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="SG.YourSendGridApiKeyHere"

# 9. Application Observability & Monitoring (Sentry / Datadog)
SENTRY_DSN="https://your_sentry_dsn_here@o123456.ingest.sentry.io/7891011"
LOG_LEVEL="info"

