# ==============================================================================
# CareNest Frontend - Production Environment Variables Template
# Copy to Vercel Environment Variables Settings
# ==============================================================================

# Production API Endpoint (pointing to your Render / Node backend URL)
VITE_API_BASE_URL=https://carenest-backend.onrender.com/api/v1
VITE_API_URL=https://carenest-backend.onrender.com/api/v1

# Sentry Frontend Error Monitoring (Optional)
VITE_SENTRY_DSN=https://your_frontend_sentry_dsn@o123456.ingest.sentry.io/123456

# App Title & Environment Tag
VITE_APP_ENV=production
VITE_APP_NAME="CareNest Healthcare Ecosystem"

